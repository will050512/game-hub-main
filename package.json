{
  "name": "game-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 50",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test tests/smoke/shell-traversal.spec.ts",
    "smoke:adapter-resolution": "playwright test tests/smoke/adapter-resolution.spec.ts",
    "smoke:wrapper-resilience": "playwright test tests/smoke/wrapper-resilience.spec.ts",
    "smoke:save-recovery": "playwright test tests/smoke/save-recovery.spec.ts",
    "smoke:asset-fallback": "playwright test tests/smoke/asset-fallback.spec.ts",
    "validate:assets": "node scripts/validate-assets.js",
    "verify:assets": "node scripts/validate-assets.js",
    "ci": "run-s lint type-check test test:e2e validate:assets build",
    "ci:local": "tsx scripts/ci-local.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.5",
    "@capacitor/app": "^7.1.2",
    "@capacitor/app-launcher": "^7.0.4",
    "@capacitor/cli": "^7.6.5",
    "@capacitor/core": "^7.6.5",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.6",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "jeep-sqlite": "^2.8.0",
    "pinia": "^3.0.4",
    "sql.js": "^1.14.1",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/ui": "^4.1.5",
    "@vue/test-utils": "^2.4.9",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.0",
    "happy-dom": "^20.9.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
